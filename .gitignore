# HMD data (CC BY 4.0 -- do not redistribute, download from www.mortality.org)
# The download guide itself IS tracked: README points readers at it, and a fresh
# clone otherwise has no instructions for obtaining the data. Note the trailing
# `/*` -- a bare negation under a directory-level ignore does not work, because
# git will not re-include a file whose parent directory is excluded.
backend/data/hmd/*
!backend/data/hmd/DOWNLOAD_GUIDE.md

# Mexican data (do not redistribute -- download from original sources)
backend/data/inegi/*
!backend/data/inegi/DOWNLOAD_GUIDE.md
backend/data/conapo/*
!backend/data/conapo/DOWNLOAD_GUIDE.md
# NOTE: CNSF/EMSSA tables are PUBLIC regulatory data (published in CUSF/DOF).
# They are tracked in git with sex-differentiated qx_male/qx_female columns.

# Frontend build artifacts and dependencies
frontend/node_modules/
frontend/dist/
.wrangler/

# Playwright E2E artifacts
node_modules/
playwright-report/
test-results/
# NOTE: `e2e/**/*-snapshots/` is deliberately NOT ignored. Those directories
# hold the visual-regression baselines, which are the reference the tests
# compare against -- ignoring them made those tests unable to pass on a fresh
# clone. Run artifacts (above) stay ignored.

# PDF reference docs (large binaries -- not authored docs)
backend/data/mortality_tables/*.pdf

# Subagent outputs
subagents_outputs/

# Supplementary research documents
supplementary-docs/

# Claude ephemeral (config files ARE tracked)
.claude/cache/
.claude/debug/
.claude/downloads/
.claude/file-history/
.claude/session-env/
.claude/shell-snapshots/
.claude/todos/
.claude/tasks/
.claude/history.jsonl
.claude/stats-cache.json
.claude/.credentials.json
.claude/*.backup.*
.claude/settings.local.json

